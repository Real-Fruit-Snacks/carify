# Versions CI installs, and the dev kit bundles or names. test.yml and offline.yml load this
# file into the environment, and tools/build-dev-kit.ps1 and the kit's offline/setup.ps1 read it,
# so changing a version here changes it everywhere. KEY=value lines only; no quotes.
# The art script's Python packages are pinned in docs/art/requirements.txt.

# The PowerShell linter (lint job; bundled in the dev kit)
PSSCRIPTANALYZER_VERSION=1.25.0
# The Python that runs docs/art/make-art.py (art job; the dev kit's wheels are built for it)
PYTHON_VERSION=3.13.17
# ffmpeg for the Windows tests: Chocolatey's ffmpeg package, gyan.dev's essentials build
FFMPEG_CHOCO_VERSION=9.0.2
# ShellCheck for carify, install.sh and tests/run.sh (lint job)
SHELLCHECK_VERSION=0.11.0
